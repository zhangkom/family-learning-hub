{
  "name": "family-learning-android",
  "version": "0.2.6",
  "androidVersionCode": 8,
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint src scripts vite.config.ts capacitor.config.ts",
    "dev": "vite --host 127.0.0.1",
